                "punctuation.definition.inline.tag.jsdoc",
                "comment keyword.other",
                "comment keyword.control"
            ],
            "settings": {
                "foreground": "#61c8ff"
            }
        },
        {
            "name": "Doc comment content",
            "scope": [
                "comment variable",
                "comment entity.name.type",
                "comment entity.name.function",
                "comment entity.name.class",
                "comment entity.other.attribute-name",
